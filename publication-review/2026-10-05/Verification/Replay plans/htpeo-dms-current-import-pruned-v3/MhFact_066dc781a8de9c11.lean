/-- a 4-vertex side has recipe D or E -/
theorem Cut2.recDE_small (C : Cut2 P) (k : Nat) (hk : k = 2 ∨ k = 3) (hiso : IsoFrom C.clo (repG k)) :
    C.RecipeD ∨ C.RecipeE := by
  rcases hk with rfl | rfl
  · obtain ⟨α, β, hm⟩ := hiso
    obtain ⟨α', β', hm', hj⟩ := C.aut_iso 2 autChk_2 hm
    rcases autR_2 (β (Fin.last X.m)) with h | h <;> rw [h] at hj
    · exact Or.inl (C.recipeD_of_iso (repL_ok 2 (by decide)) hm' hj recD_2_0_0 recD_2_0_1)
    · exact Or.inr (C.recipeE_of_iso (repL_ok 2 (by decide)) hm' hj recE_2_2_0 recE_2_2_1)
  · obtain ⟨α, β, hm⟩ := hiso
    obtain ⟨α', β', hm', hj⟩ := C.aut_iso 3 autChk_3 hm
    rw [autR_3 (β (Fin.last X.m))] at hj
    exact Or.inr (C.recipeE_of_iso (repL_ok 3 (by decide)) hm' hj recE_3_0_0 recE_3_0_1)

theorem not_simple_of_par {Y : MGraph} {Q : Fin Y.m → Prop} {H : MGraph} (h : IsoFrom Q H) {p q : Fin Y.m}
    (hp : Q p) (hq : Q q) (hpq : p ≠ q) {u v : Fin Y.n} (jp : Y.Joins p u v) (jq : Y.Joins q u v)
    (hH : SimpleH H) : False := by
  obtain ⟨α, β, _, hβ, _, hj⟩ := h
  have j1 : H.Joins (β p) (α u) (α v) := by
    have := hj p hp; rcases jp with h1 | h1 <;> rw [h1] at this
    · exact this
    · exact Or.symm this
  have j2 : H.Joins (β q) (α u) (α v) := by
    have := hj q hq; rcases jq with h1 | h1 <;> rw [h1] at this
    · exact this
    · exact Or.symm this
  exact hpq (hβ p q hp hq (hH _ _ _ _ j1 j2))

theorem simple25 : SimpleH (repG 25) := by intro e e' p q; revert e e' p q; decide

theorem T5_of_8 (k : Nat) (hk : k ≤ 25) (h1 : 1 ≤ k) (h8 : repN k = 8) (hne : k ≠ 25) : T5 k := by
  unfold T5
  rcases (by omega : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨ k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨ k = 24 ∨ k = 25) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [repN]
theorem k_of_4 (k : Nat) (hk : k ≤ 25) (h1 : 1 ≤ k) (h4 : repN k = 4) : k = 2 ∨ k = 3 := by
  rcases (by omega : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨ k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨ k = 24 ∨ k = 25) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [repN]
theorem bad_of (k : Nat) (hk : k ≤ 25) (h1 : 1 ≤ k) (hT : ¬ T5 k) :
    (k = 4 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 25) ∧ 6 ≤ repN k := by
  unfold T5 at hT
  rcases (by omega : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨ k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨ k = 24 ∨ k = 25) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [repN]
theorem bad8 (k : Nat) (hk : k ≤ 25) (h1 : 1 ≤ k) (hT : ¬ T5 k) (h8 : repN k = 8) : k = 25 := by
  unfold T5 at hT
  rcases (by omega : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨ k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨ k = 24 ∨ k = 25) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [repN]

/-- (s2) a 6-vertex side is digon-good -/
theorem sfS2 : ∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 6 → EX1On C.cloD := by
  intro X P C hG h6
  have hv : vcount C.cloD = 8 := by rw [C.vcount_cloD, h6]
  obtain ⟨k, hk1, hk25, hkn, hiso⟩ := cls 8 _ _ (C.cloD_inG hG) hv (by decide) (Nat.le_refl 8)
  have hne : k ≠ 25 := by
    rintro rfl
    exact not_simple_of_par hiso (Or.inl rfl) (Or.inr (Or.inl rfl)) C.dl1_ne_dl2 C.XD_joins_dl1 C.XD_joins_dl2 simple25
  exact ex1On_of_iso hiso (ex1Full_rep k (T5_of_8 k hk25 hk1 hkn hne))

/-- (s3) a 4-vertex side is closed-good and has recipe D or E -/
theorem sfS3 : ∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 4 →
    EX1On C.clo ∧ (C.RecipeD ∨ C.RecipeE) := by
  intro X P C hG h4
  have hv : vcount C.clo = 4 := by rw [C.vcount_clo, h4]
  obtain ⟨k, hk1, hk25, hkn, hiso⟩ := cls 4 _ _ (C.clo_inG hG) hv (by decide) (by decide)
  have hk := k_of_4 k hk25 hk1 hkn
  refine ⟨ex1On_of_iso hiso (ex1Full_rep k ?_), C.recDE_small k hk hiso⟩
  rcases hk with rfl | rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))

/-- (s4) a side with at most 8 vertices that is not closed-good has recipe D and at least 6 vertices -/
theorem sfS4 : ∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true ≤ 8 → ¬ EX1On C.clo →
    C.RecipeD ∧ 6 ≤ scount P C.S true := by
  intro X P C hG h8 hne
  have hpos := C.side_pos
  obtain ⟨k, hk1, hk25, hkn, hiso⟩ := cls _ _ _ (C.clo_inG hG) C.vcount_clo (by omega) h8
  have hT : ¬ T5 k := fun hT => hne (ex1On_of_iso hiso (ex1Full_rep k hT))
  obtain ⟨hk, h6⟩ := bad_of k hk25 hk1 hT
  refine ⟨?_, by rw [← hkn]; exact h6⟩
  rcases hk with rfl | rfl | rfl | rfl | rfl
  · exact C.recD_4 hiso
  · exact C.recD_6 hiso
  · exact C.recD_7 hiso
  · exact C.recD_8 hiso
  · exact C.recD_25 hiso

/-- (s5) an 8-vertex side that is not closed-good has recipe E -/
theorem sfS5 : ∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 8 → ¬ EX1On C.clo →
    C.RecipeE := by
  intro X P C hG h8 hne
  obtain ⟨k, hk1, hk25, hkn, hiso⟩ := cls 8 _ _ (C.clo_inG hG) (by rw [C.vcount_clo, h8]) (by decide) (Nat.le_refl 8)
  have hT : ¬ T5 k := fun hT => hne (ex1On_of_iso hiso (ex1Full_rep k hT))
  have := bad8 k hk25 hk1 hT hkn
  subst this
  exact C.recE_25 hiso

end sa

end RH2F

namespace RH2F
open MGraph

/-- **Layer 8 of the Lean formalization of RH2**: the small-side facts (s2)–(s5) of EX1-RED (fact 0e90cbc9a9e79513),
    from the classification (fact 6e44d3c2232b5736), the T5 certificates, the automorphism tables and the recipe
    certificates of the 2-poles (TAB-A, TAB-B). -/
theorem layer8 :
    (∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 6 → EX1On C.cloD) ∧
    (∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 4 →
      EX1On C.clo ∧ (C.RecipeD ∨ C.RecipeE)) ∧
    (∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true ≤ 8 → ¬ EX1On C.clo →
      C.RecipeD ∧ 6 ≤ scount P C.S true) ∧
    (∀ (X : MGraph) (P : Fin X.m → Prop) (C : Cut2 P), InG X P → scount P C.S true = 8 → ¬ EX1On C.clo →
      C.RecipeE) :=
  ⟨sfS2, sfS3, sfS4, sfS5⟩

end RH2F
