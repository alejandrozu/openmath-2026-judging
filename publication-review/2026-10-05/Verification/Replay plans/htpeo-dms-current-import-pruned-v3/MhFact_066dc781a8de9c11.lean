theorem repL_ok : ∀ k, k ≤ 25 → elOK (repN k) (repL k) = true := by decide +kernel

/-- the representatives of table T5 (EX1-full) -/
def T5 (k : Nat) : Prop := k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 5 ∨ (9 ≤ k ∧ k ≤ 24)

theorem ex1Full_rep (k : Nat) (hk : T5 k) : EX1FullH (repG k) := by
  rcases hk with rfl | rfl | rfl | rfl | ⟨h1, h2⟩
  · exact ex1Full_of_cert (hn := repN_pos 1) ex1rep_1
  · exact ex1Full_of_cert (hn := repN_pos 2) ex1rep_2
  · exact ex1Full_of_cert (hn := repN_pos 3) ex1rep_3
  · exact ex1Full_of_cert (hn := repN_pos 5) ex1rep_5
  · rcases (by omega : k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨
      k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨ k = 24) with
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ex1Full_of_cert (hn := repN_pos 9) ex1rep_9
    · exact ex1Full_of_cert (hn := repN_pos 10) ex1rep_10
    · exact ex1Full_of_cert (hn := repN_pos 11) ex1rep_11
    · exact ex1Full_of_cert (hn := repN_pos 12) ex1rep_12
    · exact ex1Full_of_cert (hn := repN_pos 13) ex1rep_13
    · exact ex1Full_of_cert (hn := repN_pos 14) ex1rep_14
    · exact ex1Full_of_cert (hn := repN_pos 15) ex1rep_15
    · exact ex1Full_of_cert (hn := repN_pos 16) ex1rep_16
    · exact ex1Full_of_cert (hn := repN_pos 17) ex1rep_17
    · exact ex1Full_of_cert (hn := repN_pos 18) ex1rep_18
    · exact ex1Full_of_cert (hn := repN_pos 19) ex1rep_19
    · exact ex1Full_of_cert (hn := repN_pos 20) ex1rep_20
    · exact ex1Full_of_cert (hn := repN_pos 21) ex1rep_21
    · exact ex1Full_of_cert (hn := repN_pos 22) ex1rep_22
    · exact ex1Full_of_cert (hn := repN_pos 23) ex1rep_23
    · exact ex1Full_of_cert (hn := repN_pos 24) ex1rep_24

/-- composing the closure isomorphism with the automorphism of the table sends `g_A` to a representative entry -/
theorem Cut2.aut_iso (C : Cut2 P) (k : Nat) (hchk : autChk k = true) {α : Fin X.n → Fin (repG k).n}
    {β : Fin (addEdge X C.a1 C.a2).m → Fin (repG k).m} (hiso : IsoMap C.clo (repG k) α β) :
    ∃ α' β', IsoMap C.clo (repG k) α' β' ∧ (β' (Fin.last X.m)).val = (autD k (β (Fin.last X.m)).val).1 := by
  have h := allFin_sound hchk (β (Fin.last X.m))
  simp only [Bool.and_eq_true] at h
  exact ⟨_, _, isoMap_comp hiso (concMap_of_chk h.1), Nat.eq_of_beq_eq_true h.2⟩

/-- recipe-D checks of the concrete pole of `Rep_k` at `j0` in both orientations -/
def RecOKD (k j0 : Nat) : Prop :=
  (∃ cs, recipeDB (repN k) (poleEl (repL k) (repN k) j0 false) j0 (repL k).length (gE (repL k) j0).1 (gE (repL k) j0).2 cs = true) ∧
  (∃ cs, recipeDB (repN k) (poleEl (repL k) (repN k) j0 true) j0 (repL k).length (gE (repL k) j0).2 (gE (repL k) j0).1 cs = true)

def RecOKE (k j0 : Nat) : Prop :=
  (∃ cs, recipeEB (repN k) (poleEl (repL k) (repN k) j0 false) j0 (repL k).length (gE (repL k) j0).1 (gE (repL k) j0).2 cs = true) ∧
  (∃ cs, recipeEB (repN k) (poleEl (repL k) (repN k) j0 true) j0 (repL k).length (gE (repL k) j0).2 (gE (repL k) j0).1 cs = true)

theorem Cut2.recD_via (C : Cut2 P) (k : Nat) (hk : k ≤ 25) (hchk : autChk k = true) (hiso : IsoFrom C.clo (repG k))
    (hrec : ∀ i : Fin (repG k).m, RecOKD k (autD k i.val).1) : C.RecipeD := by
  obtain ⟨α, β, hm⟩ := hiso
  obtain ⟨α', β', hm', hj⟩ := C.aut_iso k hchk hm
  obtain ⟨⟨cs0, h0⟩, ⟨cs1, h1⟩⟩ := hrec (β (Fin.last X.m))
  exact C.recipeD_of_iso (repL_ok k hk) hm' hj h0 h1

theorem Cut2.recE_via (C : Cut2 P) (k : Nat) (hk : k ≤ 25) (hchk : autChk k = true) (hiso : IsoFrom C.clo (repG k))
    (hrec : ∀ i : Fin (repG k).m, RecOKE k (autD k i.val).1) : C.RecipeE := by
  obtain ⟨α, β, hm⟩ := hiso
  obtain ⟨α', β', hm', hj⟩ := C.aut_iso k hchk hm
  obtain ⟨⟨cs0, h0⟩, ⟨cs1, h1⟩⟩ := hrec (β (Fin.last X.m))
  exact C.recipeE_of_iso (repL_ok k hk) hm' hj h0 h1

theorem autR_4 : ∀ i : Fin (repG 4).m, (autD 4 i.val).1 = 0 ∨ (autD 4 i.val).1 = 4 := by decide +kernel
theorem Cut2.recD_4 (C : Cut2 P) (hiso : IsoFrom C.clo (repG 4)) : C.RecipeD :=
  C.recD_via 4 (by decide) autChk_4 hiso (fun i => by
    rcases autR_4 i with h | h <;> rw [h]
    · exact ⟨⟨_, recD_4_0_0⟩, ⟨_, recD_4_0_1⟩⟩
    · exact ⟨⟨_, recD_4_4_0⟩, ⟨_, recD_4_4_1⟩⟩)

