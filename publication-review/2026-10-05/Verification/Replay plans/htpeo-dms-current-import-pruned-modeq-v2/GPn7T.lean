/-- index into row `n % 8` of `tabs` of the pattern of block `J` -/
def idx (n J : Nat) : Nat :=
  if J < n - n % 8 - 8 then J % 8 else 8 + (J - (n - n % 8 - 8))

/-- the pattern of block `J` -/
def chi (n J : Nat) : List Nat :=
  if n < 31 then (smallTab.getD (n - 15) []).getD J [] else (tabs.getD (n % 8) []).getD (idx n J) []

/-- the colouring -/
def col (n : Nat) : Fin (gp n 7).m → Fin 5 := bcol 3 ct ct_lt (chi n)

abbrev winsAll (n : Nat) : Prop :=
  ∀ j, j < n → winOK (gpkWir 7) ct (fun _ => ()) (fun q => chi n ((j + q) % n)) = true

