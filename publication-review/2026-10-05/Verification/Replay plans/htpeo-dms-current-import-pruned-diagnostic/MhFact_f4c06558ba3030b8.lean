open MGraph
open Classical

section lm8
variable {X : MGraph} {P : Fin X.m → Prop}

/-- the leaf graphs of all 25 representatives are star 6-colourable -/
theorem leaf_rep25 (k : Nat) (hk1 : 1 ≤ k) (hk : k ≤ 25) :
    ∀ j : Fin (repG k).m, Colourable (leafSet (fun _ : Fin (repG k).m => True) j) 6 := by
  rcases (by omega : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨
    k = 12 ∨ k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 ∨ k = 17 ∨ k = 18 ∨ k = 19 ∨ k = 20 ∨ k = 21 ∨ k = 22 ∨ k = 23 ∨
    k = 24 ∨ k = 25) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [leaf_of_cert lfc1, leaf_of_cert lfc2, leaf_of_cert lfc3, leaf_of_cert lfc4, leaf_of_cert lfc5,
    leaf_of_cert lfc6, leaf_of_cert lfc7, leaf_of_cert lfc8, leaf_of_cert lfc9, leaf_of_cert lfc10,
    leaf_of_cert lfc11, leaf_of_cert lfc12, leaf_of_cert lfc13, leaf_of_cert lfc14, leaf_of_cert lfc15,
    leaf_of_cert lfc16, leaf_of_cert lfc17, leaf_of_cert lfc18, leaf_of_cert lfc19, leaf_of_cert lfc20,
    leaf_of_cert lfc21, leaf_of_cert lfc22, leaf_of_cert lfc23, leaf_of_cert lfc24, leaf_of_cert lfc25]

/-- **the leaf graphs of members of 𝒢 with at most 8 vertices are star 6-colourable** -/
theorem small_leaf (hG : InG X P) (h8 : vcount P ≤ 8) {g : Fin X.m} (hg : P g) : Colourable (leafSet P g) 6 := by
  have hpos : 0 < vcount P := cntF_le_of_mem _ _ (i := (X.ends g).1) ⟨g, hg, Or.inl rfl⟩
  obtain ⟨k, hk1, hk25, _, α, β, hα, hβ, _, hj⟩ := cls _ X P hG rfl hpos h8
  exact leaf_of_iso hG.1 hα hβ hj hg (leaf_rep25 k hk1 hk25 (β g))

end lm8

/-- (II_D) from the leaf engine statements and LMC14 alone -/
theorem iid_of_ne' (hL14 : LMC14) (hextT : FEEXTTNE16) (hex0 : FEEXIST0NE16) : IID := by
  intro X P hG h6 h2 g hg hpar hcut
  have hev := vcount_even RH2P.pstat hG
  have hel : Eligible P g := ⟨hg, hpar, hcut⟩
  by_cases h8 : vcount P ≤ 8
  · exact small_leaf hG h8 hg
  by_cases h14 : vcount P ≤ 14
  · obtain ⟨c, hc⟩ := hL14 X P hG h2 (by omega) h14 g hel
    exact ⟨c, hc.1⟩
  have h16 : 16 ≤ vcount P := by omega
  obtain ⟨M, hM, hMg, C, hC, hCg, hne⟩ := hex0 X P hG h2 h16 g hel
  obtain ⟨c, hc, _⟩ := hextT X P hG h2 h16 g hel M C hM hMg hC hCg hne
  exact ⟨c, hc⟩

/-- **layer 20**: small leaf graphs; (II_D) from the leaf engine statements without LMC8 -/
theorem layer20 :
    (∀ (X : MGraph) (P : Fin X.m → Prop), InG X P → vcount P ≤ 8 → ∀ g, P g → Colourable (leafSet P g) 6) ∧
    (LMC14 → FEEXTTNE16 → FEEXIST0NE16 → IID) :=
  ⟨fun _ _ hG h8 _ hg => small_leaf hG h8 hg, iid_of_ne'⟩

end RH2F
