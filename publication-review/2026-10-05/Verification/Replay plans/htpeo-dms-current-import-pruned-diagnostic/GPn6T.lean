/-- index into row `n % 7` of `tabs` of the pattern of block `J` -/
def idx (n J : Nat) : Nat :=
  if J < n - n % 7 - 7 then J % 7 else 7 + (J - (n - n % 7 - 7))

/-- the pattern of block `J` -/
def chi (n J : Nat) : List Nat :=
  if n < 27 then (smallTab.getD (n - 13) []).getD J [] else (tabs.getD (n % 7) []).getD (idx n J) []

/-- the colouring -/
def col (n : Nat) : Fin (gp n 6).m → Fin 5 := bcol 3 ct ct_lt (chi n)

abbrev winsAll (n : Nat) : Prop :=
  ∀ j, j < n → winOK (gpkWir 6) ct (fun _ => ()) (fun q => chi n ((j + q) % n)) = true

end GPn6
