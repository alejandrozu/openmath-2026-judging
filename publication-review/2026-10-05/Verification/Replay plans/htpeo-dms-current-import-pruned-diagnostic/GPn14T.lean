/-- index into row `n % 10` of `tabs` of the pattern of block `J` -/
def idx (n J : Nat) : Nat :=
  if J < n - n % 10 - 20 then J % 10 else 10 + (J - (n - n % 10 - 20))

/-- the pattern of block `J` -/
def chi (n J : Nat) : List Nat :=
  if n < 59 then (smallTab.getD (n - 29) []).getD J [] else (tabs.getD (n % 10) []).getD (idx n J) []

/-- the colouring -/
def col (n : Nat) : Fin (gp n 14).m → Fin 5 := bcol 3 ct ct_lt (chi n)

abbrev winsAll (n : Nat) : Prop :=
  ∀ j, j < n → winOK (gpkWir 14) ct (fun _ => ()) (fun q => chi n ((j + q) % n)) = true

end GPn14
