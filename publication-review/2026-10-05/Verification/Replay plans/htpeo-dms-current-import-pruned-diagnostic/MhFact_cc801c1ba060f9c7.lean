/-- certificates of one host split into pieces -/
theorem good_of_pieces {q : Nat} {hq : 0 < q} {el : List (Nat × Nat)} {RC : List Nat} (Cs : List (List Cert))
    (h : ∀ C ∈ Cs, hostCert q el C = true) (hc : codesIn RC Cs.flatten = true) :
    ∀ rc ∈ RC, GoodH (digGrC q hq el rc) := by
  intro rc hrc
  obtain ⟨c, hcC, hcr⟩ := anyR_mem (allR_mem hc hrc)
  obtain ⟨C, hC, hcC'⟩ := List.mem_flatten.1 hcC
  have := hostCert_sound (hq := hq) (h C hC) c hcC'
  rw [Nat.eq_of_beq_eq_true hcr] at this
  exact this

/-- **the members of 𝒟 with 10 or 12 vertices**, from certified representatives -/
theorem d1012_of (hgood4 : (∀ k, k < sRep4.length → ∀ rc ∈ dRCa4.getD k [], GoodH (digGrC 4 (by decide) (sRep4.getD k []) rc)))
    (hgood6 : (∀ k, k < sRep6.length → ∀ rc ∈ dRCa6.getD k [], GoodH (digGrC 6 (by decide) (sRep6.getD k []) rc)))
    (hgood8 : (∀ k, k < sRep8.length → ∀ rc ∈ dRCa8.getD k [], GoodH (digGrC 8 (by decide) (sRep8.getD k []) rc)))
    (hgood10 : (∀ k, k < sRep10.length → ∀ rc ∈ dRCa10.getD k [], GoodH (digGrC 10 (by decide) (sRep10.getD k []) rc)))
    (hgood12 : (∀ k, k < sRep12.length → GoodH (digGrC 12 (by decide) (sRep12.getD k []) 0))) :
    ∀ (X : MGraph) (P : Fin X.m → Prop), InG X P → TwoCutReducedOn P → 10 ≤ vcount P → vcount P ≤ 12 →
      EX1On P ∧ ∀ g, Eligible P g → Colourable (leafSet P g) 6 := by
  intro X P hG h2 h10 h12
  obtain ⟨Y, Q, D, hS, h4, hev, hv, hIso⟩ := to_dig hG h2 h10
  have hcases : vcount Q = 4 ∨ vcount Q = 6 ∨ vcount Q = 8 ∨ vcount Q = 10 ∨ vcount Q = 12 := by omega
  rcases hcases with hq' | hq' | hq' | hq' | hq'
  · -- `|V(Q)| = 4`
    obtain ⟨k, hk, rc, hrc, hI⟩ := digClassB (hq := (by decide : 0 < 4)) (by decide) dCovA4 scl4 Y Q D hS hq' (by omega) (by omega)
    have hp := digGrC_pos (by decide : 0 < 4) (sRep4.getD k []) (by have := (repsB_get sRep4_B hk).2.1; omega) rc
    exact concl_of_iso hG (hIso _ hI hp.1 hp.2) (hgood4 k hk rc hrc)
  · -- `|V(Q)| = 6`
    obtain ⟨k, hk, rc, hrc, hI⟩ := digClassB (hq := (by decide : 0 < 6)) (by decide) dCovA6 scl6 Y Q D hS hq' (by omega) (by omega)
    have hp := digGrC_pos (by decide : 0 < 6) (sRep6.getD k []) (by have := (repsB_get sRep6_B hk).2.1; omega) rc
    exact concl_of_iso hG (hIso _ hI hp.1 hp.2) (hgood6 k hk rc hrc)
  · -- `|V(Q)| = 8`
    obtain ⟨k, hk, rc, hrc, hI⟩ := digClassB (hq := (by decide : 0 < 8)) (by decide) dCovA8 scl8 Y Q D hS hq' (by omega) (by omega)
    have hp := digGrC_pos (by decide : 0 < 8) (sRep8.getD k []) (by have := (repsB_get sRep8_B hk).2.1; omega) rc
    exact concl_of_iso hG (hIso _ hI hp.1 hp.2) (hgood8 k hk rc hrc)
  · -- `|V(Q)| = 10`
    obtain ⟨k, hk, rc, hrc, hI⟩ := digClassB (hq := (by decide : 0 < 10)) (by decide) dCovA10 scl10 Y Q D hS hq' (by omega) (by omega)
    have hp := digGrC_pos (by decide : 0 < 10) (sRep10.getD k []) (by have := (repsB_get sRep10_B hk).2.1; omega) rc
    exact concl_of_iso hG (hIso _ hI hp.1 hp.2) (hgood10 k hk rc hrc)
  · -- `|V(Q)| = 12`, no digons
    obtain ⟨k, hk, hI⟩ := digClassZ (hq := (by decide : 0 < 12)) (hostsOK_of_repsB sRep12_B (by decide)) scl12 Y Q D hS hq' (by omega)
    have hp := digGrC_pos (by decide : 0 < 12) (sRep12.getD k []) (by have := (repsB_get sRep12_B hk).2.1; omega) 0
    exact concl_of_iso hG (hIso _ hI hp.1 hp.2) (hgood12 k hk)

