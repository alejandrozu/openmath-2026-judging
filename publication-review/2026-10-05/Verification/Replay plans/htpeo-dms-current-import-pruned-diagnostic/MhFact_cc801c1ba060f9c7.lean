/-- **Layer 31b**: the members of 𝒟 with 10–12 vertices, resp. 14 vertices, from certified representatives -/
theorem layer31b :
    ((∀ k, k < sRep4.length → ∀ rc ∈ dRCa4.getD k [], GoodH (digGrC 4 (by decide) (sRep4.getD k []) rc)) →
      (∀ k, k < sRep6.length → ∀ rc ∈ dRCa6.getD k [], GoodH (digGrC 6 (by decide) (sRep6.getD k []) rc)) →
      (∀ k, k < sRep8.length → ∀ rc ∈ dRCa8.getD k [], GoodH (digGrC 8 (by decide) (sRep8.getD k []) rc)) →
      (∀ k, k < sRep10.length → ∀ rc ∈ dRCa10.getD k [], GoodH (digGrC 10 (by decide) (sRep10.getD k []) rc)) →
      (∀ k, k < sRep12.length → GoodH (digGrC 12 (by decide) (sRep12.getD k []) 0)) →
      (∀ (X : MGraph) (P : Fin X.m → Prop), InG X P → TwoCutReducedOn P → 10 ≤ vcount P → vcount P ≤ 12 → EX1On P ∧ ∀ g, Eligible P g → Colourable (leafSet P g) 6)) ∧
    ((∀ k, k < sRep4.length → ∀ rc ∈ dRCb4.getD k [], GoodH (digGrC 4 (by decide) (sRep4.getD k []) rc)) →
      (∀ k, k < sRep6.length → ∀ rc ∈ dRCb6.getD k [], GoodH (digGrC 6 (by decide) (sRep6.getD k []) rc)) →
      (∀ k, k < sRep8.length → ∀ rc ∈ dRCb8.getD k [], GoodH (digGrC 8 (by decide) (sRep8.getD k []) rc)) →
      (∀ k, k < sRep10.length → ∀ rc ∈ dRCb10.getD k [], GoodH (digGrC 10 (by decide) (sRep10.getD k []) rc)) →
      (∀ k, k < sRep12.length → ∀ rc ∈ dRCb12.getD k [], GoodH (digGrC 12 (by decide) (sRep12.getD k []) rc)) →
      (∀ k, k < sRep14.length → GoodH (digGrC 14 (by decide) (sRep14.getD k []) 0)) →
      (∀ (X : MGraph) (P : Fin X.m → Prop), InG X P → TwoCutReducedOn P → vcount P = 14 → EX1On P ∧ ∀ g, Eligible P g → Colourable (leafSet P g) 6)) :=
  ⟨fun h4 h6 h8 h10 h12 => d1012_of h4 h6 h8 h10 h12, fun h4 h6 h8 h10 h12 h14 => d14_of h4 h6 h8 h10 h12 h14⟩

