      "source": "Reproduction_Sources/a000224/OpHack/QuadraticResidue224/Target224.lean",
      "source_sha256": "3b67f7494439886af3359a9e684433f49a6dccb7d10258d1d05dcc01de7886d0",
      "literal_theorem_statement": "theorem not_modEq_three_primes {p q r : ℕ}\n    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)\n    (hp2 : 2 < p) (hpq : p < q) (hqr : q < r) :\n    ¬ (p * q * r) ^ 2 ≡ 1 [MOD a (p * q * r) * (a (p * q * r) - 1)]",
      "expected_trust": "AXIOM_FREE_OR_STANDARD_KERNEL_AXIOMS_ONLY_EXPECTED_NOT_OBSERVED; actual raw prints must exclude sorryAx, native or unknown axioms before qualification"
    },
    {
      "endpoint": "OeisA224.conjecture_three_primes",
      "source": "Reproduction_Sources/a000224/OpHack/QuadraticResidue224/Target224.lean",
      "source_sha256": "3b67f7494439886af3359a9e684433f49a6dccb7d10258d1d05dcc01de7886d0",
      "literal_theorem_statement": "theorem conjecture_three_primes {p q r : ℕ}\n    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)\n    (hp2 : 2 < p) (hpq : p < q) (hqr : q < r) :\n    ((p * q * r).Prime ∧ p * q * r ≠ 2) ↔\n      (p * q * r) ^ 2 ≡ 1 [MOD a (p * q * r) * (a (p * q * r) - 1)]",
      "expected_trust": "AXIOM_FREE_OR_STANDARD_KERNEL_AXIOMS_ONLY_EXPECTED_NOT_OBSERVED; actual raw prints must exclude sorryAx, native or unknown axioms before qualification"
    }
  ],
