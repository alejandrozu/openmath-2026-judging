      "literal_theorem_statement": "theorem not_divisible_three_primes {p q r : ℕ}\n    (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)\n    (hp2 : 2 < p) (hpq : p < q) (hqr : q < r) :\n    ¬ a (p * q * r) * (a (p * q * r) - 1) ∣ (p * q * r) ^ 2 - 1",
      "expected_trust": "AXIOM_FREE_OR_STANDARD_KERNEL_AXIOMS_ONLY_EXPECTED_NOT_OBSERVED; actual raw prints must exclude sorryAx, native or unknown axioms before qualification"
    },
