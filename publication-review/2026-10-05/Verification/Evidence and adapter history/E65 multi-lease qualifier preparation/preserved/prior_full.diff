+def lock_existing(stack, file):
+    # Only a pre-existing lock byte is leased. No file or byte is created/edited.
+    file = Path(file)
+    require(file.is_file() and file.stat().st_size >= 1, 'Existing replay lock required: ' + str(file))
+    handle = stack.enter_context(file.open('r+b'))
+    handle.seek(0)
+    msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+
