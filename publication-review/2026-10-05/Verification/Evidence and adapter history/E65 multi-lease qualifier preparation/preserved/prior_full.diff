+    for row in rows:
+        source = Path(row['source_file'])
+        require(source.resolve().is_relative_to(BASE.resolve()), 'Official source outside this verification workspace')
+        require(source.stat().st_size == row['source_bytes'] and sha_file(source) == row['source_sha256'],
+                'Official source identity changed: ' + row['module'])
+        source_count += 1
+        require(set(row['effective_import_dependencies']) <= modules,
+                'Recorded official provider graph not closed: ' + row['module'])
+        for artifact in row['official_artifacts']:
+            file_path = Path(artifact['file'])
