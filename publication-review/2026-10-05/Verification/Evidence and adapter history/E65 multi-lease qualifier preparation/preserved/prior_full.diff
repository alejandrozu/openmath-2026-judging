+def sha_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha_file(file):
+    result = hashlib.sha256()
+    with Path(file).open('rb') as stream:
+        for chunk in iter(lambda: stream.read(4*1024*1024), b''):
+            result.update(chunk)
+    return result.hexdigest()
+
