+def identity(file, single_link=False):
+    file = Path(file)
+    before = file.stat()
+    require(file.is_file() and not file.is_symlink(), 'Regular resolved file required: ' + str(file))
+    if single_link:
+        require(before.st_nlink == 1, 'Own/witness output has an unexpected alias: ' + str(file))
+    digest = sha_file(file)
+    after = file.stat()
+    signature = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_nlink)
+    require(signature(before) == signature(after), 'File changed while hashing: ' + str(file))
+    return {'file': str(file), 'sha256': digest, 'bytes': after.st_size,
+            'volume_id': after.st_dev, 'file_id': after.st_ino,
+            'link_count': after.st_nlink, 'mtime_ns': after.st_mtime_ns}
+
