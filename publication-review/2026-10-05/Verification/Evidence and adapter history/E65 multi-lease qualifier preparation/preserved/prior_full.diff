+def read_git_identity(directory):
+    # Read-only metadata; no Git subprocess, checkout or index refresh.
+    directory = Path(directory)
+    git = directory / '.git'
+    require(git.is_dir(), 'Expected exact task-created package Git directory: ' + str(directory))
+    head = (git / 'HEAD').read_text(encoding='utf8').strip()
+    if head.startswith('ref: '):
+        ref = head[5:]
+        loose = git / ref
+        if loose.is_file():
+            head = loose.read_text(encoding='utf8').strip()
+        else:
+            matches = []
+            packed = git / 'packed-refs'
+            if packed.exists():
+                for line in packed.read_text(encoding='utf8').splitlines():
+                    if not line.startswith(('#', '^')) and line.endswith(' ' + ref):
+                        matches.append(line.split()[0])
+            require(len(matches) == 1, 'Unresolved exact package HEAD: ' + str(directory))
+            head = matches[0]
+    cfg = configparser.ConfigParser()
+    cfg.read(git / 'config', encoding='utf8')
+    return head, cfg.get('remote "origin"', 'url')
