    "stdout_excerpt": "'OpenMathReview.InfiniteAffinePaletteBarrier.no_partner_in_component' depends on axioms: [propext,\n Classical.choice,\n Quot.sound]\n'OpenMathReview.InfiniteAffinePaletteBarrier.sidon_exposed_cycle_no_partner' depends on axioms: [propext,\n Classical.choice,\n Quot.sound]\n@sidon_exposed_cycle_no_partner : ∀ {V : Type u_2} [inst : AddCommGroup V] [inst_1 : Module (ZMod 3) V]\n  [inst_2 : DecidableEq V] (S : Finset V),\n  Sidon S →\n    ∀ (a b : Color S) (J : Set (twoFactor (canonical S) a b).ConnectedComponent) (i j : Color S) {u : V × Bool}\n      (p : (twoFactor (swap (canonical S) a b J) i j).Walk u u),\n      p.IsCycle →\n        ¬∃ w q,\n            q.IsCycle ∧\n              (Walk.mapLe ⋯ p).support.toFinset = q.support.toFinset ∧\n                Disjoint (Walk.mapLe ⋯ p).edges.toFinset q.edges.toFinset\n",
