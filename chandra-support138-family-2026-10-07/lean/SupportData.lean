def coefficient (s : K) (a b c : Fin 9) : K :=
  ∑ i : Fin 23, u s i a * v s i b * w s i c

def target (a b c : Fin 9) : K :=
  if b.val / 3 == a.val % 3 && c.val / 3 == b.val % 3 && c.val % 3 == a.val / 3
  then 1 else 0

def count {R : Type*} [Zero R] [DecidableEq R] (f : Fin 23 → Fin 9 → R) : ℕ :=
  ((Finset.univ : Finset (Fin 23 × Fin 9)).filter (fun p => f p.1 p.2 ≠ 0)).card

def support (s : K) : ℕ := count (u s) + count (v s) + count (w s)

theorem count_eq_of_zero_iff {R : Type*} [Zero R] [DecidableEq R] (f : Fin 23 → Fin 9 → K)
    (g : Fin 23 → Fin 9 → R) (h : ∀ i a, f i a = 0 ↔ g i a = 0) : count f = count g := by
  classical
  unfold count
  congr 1
  ext p
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact not_congr (h p.1 p.2)

#print axioms count_eq_of_zero_iff
